<?xml version="1.0"?>
<!-- The unit tests of the module's pure classes, without Drupal. See skills/smarter-drupal-testing. -->
<phpunit
  bootstrap="vendor/autoload.php"
  colors="true"
  cacheDirectory="build/.phpunit.cache"
  failOnRisky="true"
  failOnWarning="true">
  <testsuites>
    <testsuite name="unit">
      <directory>tests/src/Unit</directory>
    </testsuite>
  </testsuites>
  <source>
    <include>
      <file>src/Validation.php</file>
      <file>src/EmbedConfig.php</file>
    </include>
  </source>
  <coverage>
    <report>
      <text outputFile="php://stdout" showOnlySummary="false"/>
      <clover outputFile="build/coverage.xml"/>
    </report>
  </coverage>
</phpunit>
