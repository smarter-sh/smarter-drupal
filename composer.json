{
  "name": "smarter-sh/smarter-drupal",
  "description": "Smarter Chat for Drupal: add a Smarter chatbot to a Drupal site.",
  "type": "drupal-module",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/smarter-sh/smarter-drupal",
  "support": {
    "issues": "https://github.com/smarter-sh/smarter-drupal/issues",
    "docs": "https://docs.smarter.sh/en/latest/smarter-framework/smarter-drupal.html"
  },
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "drupal/coder": "^8.3",
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "Drupal\\smarter_chat\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Drupal\\Tests\\smarter_chat\\": "tests/src/"
    }
  },
  "extra": {
    "installer-name": "smarter_chat"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "platform": {
      "php": "8.1.31"
    },
    "sort-packages": true
  }
}
